# Maven Credentials Environment Variables
# Created during installation with your registry: {{REGISTRY}}
# Copy this file to .env and set your actual credentials
# Never commit .env to version control!

# Container Registry Authentication
# Registry: {{REGISTRY}}
export DOCKER_USERNAME=your-username
export DOCKER_PASSWORD=your-token-or-password

# GitHub Container Registry (if using ghcr.io)
# export GITHUB_USERNAME=your-github-username
# export GITHUB_TOKEN=ghp_xxxxxxxxxxxxx

# SonarQube/SonarCloud
export SONAR_TOKEN=your-sonarcloud-token-here
export SONAR_LOCAL_TOKEN=your-local-sonar-token-here

# Maven Repository (Nexus/Artifactory)
export MAVEN_REPO_USERNAME=your-maven-username
export MAVEN_REPO_PASSWORD=your-maven-password

# Maven JVM Options
# Parallel builds: Use 1 thread per CPU core for faster builds
export MAVEN_OPTS="-T 1C"

# Usage:
# 1. Source before Maven: source .env
# 2. mvn clean install

# Note:
# 1. If you are using a CI/CD pipeline, set these environment variables in your pipeline configuration instead of using a .env file.
# 2. You can recreate this file by running ./additional-setup.sh and following the prompts to set your credentials.
